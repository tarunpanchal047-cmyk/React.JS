    {
      "id": "9K9KNoMTxtzWUIk4O_8pZ",
      "type": "text",
      "x": -9664.246038207948,
      "y": 398.95835342812416,
      "width": 2754.3984375,
      "height": 50225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
